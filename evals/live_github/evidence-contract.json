{
  "schema_version": 1,
  "required_per_variant": [
    "manifest.json",
    "preflight.json",
    "commands.ndjson",
    "bootstrap/plan.json",
    "bootstrap/receipt.json",
    "scaffold/plan.json",
    "scaffold/receipt.json",
    "scaffold/after.json",
    "scaffold/second-plan.json",
    "ingestion/result.json",
    "prioritization/result.json",
    "sprint/plan.json",
    "iterations/assertions.json",
    "sync/plan.json",
    "sync/receipt.json",
    "sync/after.json",
    "sync/second-plan.json",
    "assertions.json"
  ],
  "receipt_requirements": {
    "status": "completed",
    "plan_digest_matches": true,
    "journal_required": true
  },
  "preflight_requirements": {
    "identity": ["authenticated_login", "organization_login"],
    "permission_checks": [
      "repository_create_delete",
      "project_create_delete_link"
    ],
    "capability_results": [
      "approved_disposable_target",
      "repository_absent",
      "project_absent",
      "fields_views_iterations",
      "issues_labels",
      "hierarchy_dependencies",
      "rate_limit_sufficient"
    ],
    "native_variant_additional_capabilities": ["native_issue_types"]
  },
  "redaction_requirements": [
    "Never capture GH_TOKEN, GITHUB_TOKEN, Authorization headers, cookies, or credential-helper output",
    "Record authenticated identity and permission results, not credential material",
    "Review commands.ndjson before publishing evidence"
  ]
}
