{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aegolius-labs/agentic-backlog-kit/schemas/manifest.schema.json",
  "title": "Agentic Backlog Kit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "github", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "project_number", "issue_type_mode"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "project_number": { "type": "integer", "minimum": 1 },
        "issue_type_mode": {
          "enum": ["native", "labels", "native_or_label"]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "done_statuses", "work_item_types", "default_capacity"],
      "properties": {
        "hierarchy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "done_statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "work_item_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "default_capacity": { "type": "integer", "minimum": 1 },
        "iteration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "start_date", "duration_days"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "start_date": { "type": "string", "format": "date" },
            "duration_days": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights", "dependency_boost"],
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impact", "business_value", "enabler_value", "effort"],
          "properties": {
            "impact": { "type": "number", "minimum": 0 },
            "business_value": { "type": "number", "minimum": 0 },
            "enabler_value": { "type": "number", "minimum": 0 },
            "effort": { "type": "number", "minimum": 0 }
          }
        },
        "dependency_boost": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "score1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "type", "description", "acceptance_criteria",
        "parent", "depends_on", "impact", "effort", "business_value",
        "enabler_value", "status", "maturity", "sprint"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["Initiative", "Epic", "Feature", "Story", "Bug", "Task"]
        },
        "description": { "type": "string", "minLength": 1 },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "parent": {
          "oneOf": [{ "$ref": "#/$defs/itemId" }, { "type": "null" }]
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/itemId" },
          "uniqueItems": true
        },
        "impact": { "$ref": "#/$defs/score1to5" },
        "effort": { "$ref": "#/$defs/score1to5" },
        "business_value": { "$ref": "#/$defs/score1to5" },
        "enabler_value": { "type": "integer", "minimum": 0, "maximum": 5 },
        "status": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["idea", "refined", "ready"] },
        "sprint": { "type": ["string", "null"] }
      }
    }
  }
}
